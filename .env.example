# Generate private local values with: node scripts/setup-local.mjs
APP_PORT=3031
PORT=3000
PUBLIC_ORIGIN=http://localhost:3031
DATA_DIR=data
JWT_SECRET=
JWT_EXPIRES_IN=7d
JANUS_URL=http://localhost:8088/janus
JANUS_API_SECRET=
JANUS_ADMIN_SECRET=
JANUS_PUBLIC_URL=/janus
JANUS_PUBLIC_IP=127.0.0.1
JANUS_UDP_MIN=20100
JANUS_UDP_MAX=20199
MEDIA_PROCESSOR_TOKEN=
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_UI_PORT=8026
MAIL_FROM=ProTradingRoom <noreply@ptr.local>
RECAPTCHA_SECRET=
RECAPTCHA_SITE_KEY=
GIPHY_API_KEY=
ROOM_TIMEZONE=America/New_York
WEBHOOK_SECRET=
# Exact trusted host:port pairs for local test webhook sinks only.
LOCAL_WEBHOOK_ALLOWLIST=
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Synthetic browser harness; leave disabled outside verification.
ENABLE_LOCAL_QA=0
# Optional outbound adapters; all disabled during local verification.
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_JSON=
TWILIO_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
YOUTUBE_RTMP_ENABLED=false
FACEBOOK_RTMP_ENABLED=false
OBS_RTMP_PORT=1936
# Test-only relay sink settings; leave empty/false normally.
STREAM_TEST_MODE=false
STREAM_LOCAL_TEST_BASE=
STREAM_LOCAL_ALLOWLIST=
OBS_INGEST_ENABLED=true
OBS_PUBLIC_BASE=rtmp://localhost:1936
# External SMTP can be enabled only in a deployment-specific Compose override.
SMTP_EXTERNAL_ENABLED=false
RECORDING_EXPORTS_ENABLED=false
RECORDING_EXPORT_S3_REGION=
TWILIO_VOICE_ENABLED=false
PHONE_PUBLIC_WSS_BASE=
X_POSTING_ENABLED=false
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_USER_ACCESS_TOKEN=
X_POSTING_ROOM_ID=
MARKETPLACE_ENABLED=true
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
