general: {
 configs_folder = "/tmp/ptr-janus"
 plugins_folder = "/usr/local/lib/janus/plugins"
 transports_folder = "/usr/local/lib/janus/transports"
 events_folder = "/usr/local/lib/janus/events"
 loggers_folder = "/usr/local/lib/janus/loggers"
 api_secret = "__JANUS_API_SECRET__"
 admin_secret = "__JANUS_ADMIN_SECRET__"
 debug_level = 4
 session_timeout = 60
}
media: {
 rtp_port_range = "__JANUS_UDP_MIN__-__JANUS_UDP_MAX__"
}
nat: {
 nat_1_1_mapping = "__JANUS_PUBLIC_IP__"
 keep_private_host = true
 ice_lite = true
}
plugins: {
 disable = "libjanus_echotest.so,libjanus_recordplay.so,libjanus_sip.so,libjanus_nosip.so,libjanus_textroom.so,libjanus_videocall.so"
}
transports: {
 disable = "libjanus_rabbitmq.so,libjanus_pfunix.so,libjanus_nanomsgevh.so,libjanus_websockets.so"
}
